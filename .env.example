# Environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.
#
# Production deployment:
#   Use your platform's secret manager (e.g. Vercel environment variables,
#   AWS Secrets Manager, GCP Secret Manager, Doppler) rather than committing
#   secrets to a .env file.  Set NODE_ENV=production in your hosting platform.
#
# ── Server-side only (never exposed to the browser) ───────────────────────────
# All variables in this section are server-only.
# NEVER prefix them with NEXT_PUBLIC_.
# NEVER reference them in client-side React components or api-client.ts.

# ── Authentication ─────────────────────────────────────────────────────────────

# Secret used to sign and verify widget JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters. Rotate this in production if compromised.
WIDGET_SECRET=change-me-to-a-long-random-string-minimum-32-chars

# ── Widget registry ────────────────────────────────────────────────────────────
# Maps widget IDs to their allowed origins, active status, and tenant IDs.
# Format: <widgetId>|<origin1>;<origin2>|<active>|<tenantId>,...
#
# Fields:
#   widgetId       — public ID issued by the CMS to a website owner.
#   origins        — semicolon-separated exact Origin header values.
#   active         — true or false.  Set false to disable without deleting.
#   tenantId       — CMS tenant that owns this widget (scopes all RAG searches).
#
# Example (single widget):
#   WIDGET_REGISTRY=abc123|https://example.com;https://www.example.com|true|tenant-uuid-here
#
# Example (multiple tenants):
#   WIDGET_REGISTRY=abc123|https://example.com|true|tenant-1,xyz789|https://shop.io|true|tenant-2
#
# Phase 4+: Replace with a real database query to the CMS.
WIDGET_REGISTRY=

# ── CMS connection ─────────────────────────────────────────────────────────────
# CMS_URL        — base URL of the CMS.
# CMS_API_SECRET — shared secret used in both directions:
#                  • this service sends it TO the CMS (GET/PATCH requests)
#                  • the CMS sends it TO this service (inbound push notifications)
#                  Both sides must be configured with the same value.
# CMS_URL=https://your-cms.example.com
# CMS_API_SECRET=change-me-to-a-long-random-shared-secret

# ── Supabase / vector database ─────────────────────────────────────────────────
# Run supabase/migrations/001_ai_knowledge_chunks.sql once to create the table.
# SUPABASE_URL is your project URL (https://xxxx.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is from Project Settings → API → service_role key.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# Used for chat completions (LLM) and text embeddings.
# NEVER expose OPENAI_API_KEY to the browser.
# OPENAI_API_KEY=sk-...

# ── LLM configuration ──────────────────────────────────────────────────────────
# LLM chat model (default: gpt-4o). Other options: gpt-4o-mini, gpt-4-turbo.
# LLM_MODEL=gpt-4o

# Maximum tokens in the LLM response (default: 1024).
# LLM_MAX_TOKENS=1024

# Sampling temperature (0–2). Lower = more factual/deterministic. Default: 0.2.
# LLM_TEMPERATURE=0.2

# ── Embedding configuration ────────────────────────────────────────────────────
# Embedding model (default: text-embedding-3-small, 1536 dimensions).
# Other: text-embedding-3-large (higher quality), text-embedding-ada-002 (legacy).
# EMBEDDING_MODEL=text-embedding-3-small

# Max texts per embeddings API request (default: 100, max supported: 2048).
# EMBEDDING_BATCH_SIZE=100

# ── RAG pipeline ───────────────────────────────────────────────────────────────
# Minimum cosine-similarity score (0–1) for a chunk to be used as LLM context.
# Hits below this score return FALLBACK_MESSAGE without calling the LLM.
# Default: 0.75
# SIMILARITY_THRESHOLD=0.75

# Reply shown when no chunk clears SIMILARITY_THRESHOLD.
# FALLBACK_MESSAGE=I'm sorry, I don't have information on that topic. Please contact us directly for further assistance.

# ── Text chunking ──────────────────────────────────────────────────────────────
# Target characters per chunk (default: 1200 ≈ 300 tokens).
# CHUNK_SIZE=1200

# Overlap between adjacent chunks (default: 200).
# CHUNK_OVERLAP=200

# ── Background poller ──────────────────────────────────────────────────────────
# Interval in minutes for polling the CMS for pending documents (default: 5).
# Set to 0 to disable polling entirely.
# POLL_INTERVAL_MINUTES=5

# ── Phase 5B: Logging and monitoring ──────────────────────────────────────────

# Log verbosity level (default: info in production, debug in development).
# Values: debug | info | warn | error
# LOG_LEVEL=info

# Log output format (default: json in production, pretty in development).
# Set to json in production for log-aggregation services (Datadog, CloudWatch, etc.).
# Values: json | pretty
# LOG_FORMAT=json

# ── Public variables (safe to expose — prefixed with NEXT_PUBLIC_) ─────────────

# Base URL of this widget server, used by the embed snippet in widget.js.
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3000
