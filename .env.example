# Environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.

# ── Server-side only (never exposed to the browser) ───────────────────────

# Phase 3: Secret used to sign and verify widget JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters. Change this before deploying to production.
WIDGET_SECRET=change-me-to-a-long-random-string-minimum-32-chars

# Phase 3: Widget registry — maps widget IDs to their allowed origins.
# Format: <widgetId>|<origin1>;<origin2>|<active>,...
# - widgetId: the public ID issued by the CMS to a website owner.
# - origins:  semicolon-separated list of exact Origin header values allowed
#             to embed this widget (e.g. https://example.com).
# - active:   true or false — set to false to disable a widget without deleting it.
#
# Example (single widget):
#   WIDGET_REGISTRY=abc123|https://example.com;https://www.example.com|true
#
# Example (multiple widgets, comma-separated):
#   WIDGET_REGISTRY=abc123|https://example.com|true,xyz789|https://shop.io|true
#
# Phase 4+: Replace this env var with a real database query to the CMS.
WIDGET_REGISTRY=

# Phase 4+: LLM provider key (NEVER expose this to the frontend).
# OPENAI_API_KEY=sk-...

# ── Public (safe to expose — prefixed with NEXT_PUBLIC_) ──────────────────
# The base URL of this widget server, used by the embed snippet.
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3000
