# Environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.

# ── Server-side only (never exposed to the browser) ───────────────────────

# Phase 3: Secret used to sign and verify widget JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters. Change this before deploying to production.
WIDGET_SECRET=change-me-to-a-long-random-string-minimum-32-chars

# Phase 3: Widget registry — maps widget IDs to their allowed origins.
# Format: <widgetId>|<origin1>;<origin2>|<active>,...
# - widgetId: the public ID issued by the CMS to a website owner.
# - origins:  semicolon-separated list of exact Origin header values allowed
#             to embed this widget (e.g. https://example.com).
# - active:   true or false — set to false to disable a widget without deleting it.
#
# Phase 4C: tenantId added as the 4th pipe-separated field.
# Format: <widgetId>|<origin1>;<origin2>|<active>|<tenantId>
# The tenantId is baked into the JWT and scopes all RAG vector searches.
#
# Example (single widget):
#   WIDGET_REGISTRY=abc123|https://example.com;https://www.example.com|true|tenant-uuid-here
#
# Example (multiple tenants):
#   WIDGET_REGISTRY=abc123|https://example.com|true|tenant-1,xyz789|https://shop.io|true|tenant-2
#
# Phase 4+: Replace this env var with a real database query to the CMS.
WIDGET_REGISTRY=

# CMS connection — base URL and authentication secrets.
#
# CMS_URL            — base URL of the CMS (canonical). CMS_BASE_URL is also accepted.
# CMS_API_SECRET     — sent BY this service TO the CMS for GET/PATCH requests (outbound).
# CHATBOT_API_SECRET — sent BY the CMS TO this service to authenticate push notifications
#                      (POST /api/process).  Must match the value configured on the CMS.
#                      Falls back to CMS_API_SECRET if not set (single shared secret).
# CMS_URL=http://localhost:3000
# CMS_API_SECRET=<secret-this-service-sends-to-the-cms>
# CHATBOT_API_SECRET=<secret-the-cms-sends-to-this-service>

# Polling — background job that catches documents missed by push notifications.
# Runs every N minutes. Set to 0 to disable.
# POLL_INTERVAL_MINUTES=5

# RAG pipeline — out-of-scope handling.
# Minimum cosine-similarity score (0–1) a vector-search hit must reach before
# its chunk is injected as LLM context. Hits below this score are skipped and
# FALLBACK_MESSAGE is returned directly without calling the LLM.
# Default: 0.75
# SIMILARITY_THRESHOLD=0.75

# Reply shown to the user when no document chunk clears SIMILARITY_THRESHOLD.
# FALLBACK_MESSAGE=I'm sorry, I don't have information on that topic. Please contact us directly for further assistance.

# Phase 4B: AI Knowledge Processing
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API key — used for generating text embeddings (and future LLM calls).
# NEVER expose this to the frontend.
# Required for POST /api/knowledge/ingest and POST /api/knowledge/retrieve.
# OPENAI_API_KEY=sk-...

# Phase 4C: LLM chat model and generation settings.
# Chat model used for RAG-based answers (default: gpt-4o-mini).
# Other options: gpt-4o, gpt-4-turbo
# LLM_MODEL=gpt-4o-mini

# Maximum tokens in the LLM response (default: 1024).
# LLM_MAX_TOKENS=1024

# Sampling temperature (0–2). Lower = more factual/deterministic. Default: 0.2.
# LLM_TEMPERATURE=0.2

# Embedding model to use.
# Default: text-embedding-3-small (fast, cheap, 1536 dimensions)
# Other: text-embedding-3-large (higher quality), text-embedding-ada-002 (legacy)
# EMBEDDING_MODEL=text-embedding-3-small

# Max texts per embeddings API request (default: 100, max supported: 2048).
# EMBEDDING_BATCH_SIZE=100

# Target characters per text chunk (default: 1200 ≈ 300 tokens for English text).
# CHUNK_SIZE=1200

# Characters of overlap between adjacent chunks (default: 200).
# Keeps context across chunk boundaries for better retrieval quality.
# CHUNK_OVERLAP=200

# ── Public (safe to expose — prefixed with NEXT_PUBLIC_) ──────────────────
# The base URL of this widget server, used by the embed snippet.
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3000
